{
  "realm": "frappe-sso-guard",
  "enabled": true,
  "registrationAllowed": false,
  "groups": [
    {
      "name": "ucm",
      "subGroups": [{ "name": "caseworkers" }, { "name": "supervisors" }]
    }
  ],
  "clients": [
    {
      "clientId": "frappe-sso-guard",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:8000/*"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "true",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "frappe-sso-guard-directory",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "sso.active",
      "email": "sso.active@example.org",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Active",
      "lastName": "Person",
      "groups": ["/ucm/caseworkers"]
    },
    {
      "username": "sso.disabled",
      "email": "sso.disabled@example.org",
      "emailVerified": true,
      "enabled": false,
      "firstName": "Disabled",
      "lastName": "Person"
    },
    {
      "username": "sso.unverified",
      "email": "sso.unverified@example.org",
      "emailVerified": false,
      "enabled": true,
      "firstName": "Unverified",
      "lastName": "Person"
    },
    {
      "username": "sso.leaver",
      "email": "sso.leaver@example.org",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Leaving",
      "lastName": "Person"
    },
    {
      "username": "service-account-frappe-sso-guard-directory",
      "enabled": true,
      "serviceAccountClientId": "frappe-sso-guard-directory",
      "clientRoles": {
        "realm-management": ["view-users"]
      }
    }
  ]
}
